{
  "schemaVersion": 1,
  "id": "touhou_little_maid",
  "version": "${version}",
  "name": "Touhou Little Maid: Orihime",
  "description": "Unofficial Minecraft 1.18.2 backport of Touhou Little Maid: Orihime 0.8.3",
  "authors": [
    "tartaric_acid (original mod)",
    "Sh1roCu"
  ],
  "contact": {},
  "license": "MIT / CC BY-NC-SA 4.0",
  "icon": "logo_fabric.jpg",
  "environment": "*",
  "custom": {
    "cardinal-components": ["touhou_little_maid:power", "touhou_little_maid:maid_num", "touhou_little_maid:chat_tokens"]
  },
  "entrypoints": {
    "cardinal-components-entity": ["com.github.tartaricacid.touhoulittlemaid.init.InitDataAttachment"],
    "fabric-datagen": [
      "com.github.tartaricacid.touhoulittlemaid.datagen.DataGenerator"
    ],
    "client": [
      "cn.sh1rocu.touhoulittlemaid.client.TouhouLittleMaidFabricClient"
    ],
    "main": [
      "cn.sh1rocu.touhoulittlemaid.TouhouLittleMaidFabric"
    ],
    "modmenu": [
      "cn.sh1rocu.touhoulittlemaid.compat.modmenu.ModMenuApiImpl"
    ],
    "emi": [
      "com.github.tartaricacid.touhoulittlemaid.compat.emi.MaidEmiPlugin"
    ],
    "jade": [
      "com.github.tartaricacid.touhoulittlemaid.compat.jade.JadePlugin"
    ],
    "jei_mod_plugin": [
      "com.github.tartaricacid.touhoulittlemaid.compat.jei.MaidPlugin"
    ],
    "rei_common": ["com.github.tartaricacid.touhoulittlemaid.compat.rei.transfer.BackpackTransferHandler"],
    "rei_client": [
      "com.github.tartaricacid.touhoulittlemaid.compat.rei.MaidREIClientPlugin"
    ]
  },
  "mixins": [
    "touhou_little_maid.mixins.json",
    "touhou_little_maid_fabric.mixins.json"
  ],
  "accessWidener": "touhou_little_maid.accesswidener",
  "depends": {
    "fabric": "*",
    "fabricloader": ">=${loader_version}",
    "java": ">=17",
    "minecraft": [
      "${minecraft_version}"
    ],
    "forgeconfigapiport": "*",
    "porting_lib": "*",
    "cardinal-components-base": "*",
    "cardinal-components-entity": "*",
    "reach-entity-attributes": ">=2.2.0"
  }
}
